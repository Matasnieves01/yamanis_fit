rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Verifica si es admin de forma segura
    function isAdmin() {
      return isSignedIn() &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'user').lower() == 'admin';
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
      allow delete: if isAdmin();
    }

    match /workouts/{workoutId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /routines/{routineId} {
      allow read: if isSignedIn() && (isAdmin() || resource.data.clientId == request.auth.uid);
      allow write: if isAdmin();
    }

    match /routine_logs/{logId} {
      allow read: if isSignedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /notifications/{notifId} {
      allow read, update: if isSignedIn() && (
        (request.auth.uid == resource.data.userId) ||
          (isAdmin() && resource.data.targetRole == 'admin')
      );
      allow create: if isSignedIn();
      allow delete: if isAdmin();
    }

    match /promotions/{promotionId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    match /resources/{resourceId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    match /pdf_access/{accessId} {
       // Permitir lectura si el usuario es admin o si el documento pertenece al usuario actual
       // Si el documento no existe, permitimos si el accessId pertenece al usuario
       allow read: if isSignedIn() && (
         isAdmin() ||
         (exists(/databases/$(database)/documents/pdf_access/$(accessId)) &&
          get(/databases/$(database)/documents/pdf_access/$(accessId)).data.userId == request.auth.uid) ||
         accessId.startsWith(request.auth.uid + '_')
       );

       // Solo el usuario puede crear su solicitud, o el admin para gestionar
       allow create: if isSignedIn() && (
         request.resource.data.userId == request.auth.uid ||
         isAdmin()
       );

       // Solo el admin puede aprobar/rechazar
       allow update: if isAdmin();

       allow delete: if isAdmin();
     }
  }
}
